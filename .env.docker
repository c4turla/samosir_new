# ============================================================
# SAMOSIR Docker Environment
# Copy this file to .env before running docker-compose
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=SAMOSIR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

# ── Database ────────────────────────────────────────────────
DB_DATABASE=samosir_db
DB_USERNAME=samosir
DB_PASSWORD=samosir_secret
DB_ROOT_PASSWORD=root_secret
DB_EXTERNAL_PORT=3307

# ── Sanctum ─────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8000
SESSION_DOMAIN=localhost

# ── Reverb (WebSocket) ─────────────────────────────────────
REVERB_APP_ID=843532
REVERB_APP_KEY=samosirkey123
REVERB_APP_SECRET=samosirsecret456
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
